# Local POC environment variables.
# Copy to .env (or source directly) when running Ponder against a local Ollama + docker-compose stack.
#
# Usage:
#   cp .env.poc.example .env
#   # then either: export $(cat .env | xargs)
#   # or: load via your shell's dotenv mechanism

# ── Local LLM (Ollama) ──────────────────────────────────────────────────────
# Ollama exposes an OpenAI-compatible API at /v1 by default.
# Default Ollama port is 11434. The Ponder model_client appends /v1/chat/completions
# to this base, so do NOT include /v1 here.
PONDER_MODEL_URL=http://localhost:11434

# Pick an instruction-tuned model that runs on your hardware.
#
# Default: phi3.5 — Phi-3.5-mini-instruct, 3.8B parameters, Q4 quantization.
#   ~2.2 GB download, ~4 GB resident. Heavily instruction-tuned by Microsoft on
#   synthetic data — strong at structured output and few-shot pattern following,
#   which is what the schema POC needs. Comfortable on 16 GB RAM with Docker running.
#
# Alternatives by hardware:
#   Tight budget (8 GB RAM):     llama3.2:1b           ~0.8 GB download, ~1.5 GB resident
#   Comfortable (16 GB RAM):     phi3.5  (default)     ~2.2 GB / ~4 GB resident
#   Plenty (32+ GB RAM, GPU):    llama3.1:8b           ~4.9 GB / ~7 GB resident
#
# Fetch with: ollama pull phi3.5
PONDER_GENERATIVE_MODEL=phi3.5

# ── Local infrastructure (docker-compose) ───────────────────────────────────
PONDER_REDIS_URL=redis://localhost:6379
PONDER_QDRANT_URL=http://localhost:6333

# ── Encoder (runs locally on CPU; no server needed) ─────────────────────────
# Downloaded from HuggingFace on first run.
PONDER_ENCODER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Memory ──────────────────────────────────────────────────────────────────
PONDER_MEMORY_COLLECTION=hippocampus
PONDER_MEMORY_TOP_K=5

# ── Generation parameters ───────────────────────────────────────────────────
PONDER_MODEL_MAX_TOKENS=1024
PONDER_MODEL_TEMPERATURE=0.7
